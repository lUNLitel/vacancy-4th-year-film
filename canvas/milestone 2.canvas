		},
		{"id":"a76def9c91ff73ae","type":"file","file":"z Hidden/z hidden images/Pasted image 20260314235726.jpg","x":640,"y":-806,"width":400,"height":225},
		{
			"id":"430d8f892dfb5d3f",
			"type":"text",
			"text":"We are working on the texturing of the character in collaboration with Gabriella. ",
			"styleAttributes":{},
			"x":940,
			"y":-544,
			"width":260,
			"height":140
		},
		{
			"id":"b11a74ae23defe5a",
			"type":"text",
			"text":"We were going for a cartoon style lighting, but due to time constraint, we are switching to a semi realistic lighting.",
			"styleAttributes":{},
			"x":640,
			"y":-544,
			"width":260,
			"height":200
		},
